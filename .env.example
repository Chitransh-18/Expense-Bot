# ExpenseTracker Pro Environment Configuration Template

# Server Port & Mode
PORT=5000
FLASK_ENV=development # Change to 'production' on deployment

# JWT Secret Key (Generate a random 64-character secret for production)
SECRET_KEY=change_this_to_a_super_secret_jwt_key_2026

# Database Connection
# Leave empty to use local SQLite (database.sqlite)
# Or set PostgreSQL URL for Docker/Production:
# DATABASE_URL=postgresql://expenseuser:expensesecretpassword@db:5432/expensetracker

# SMTP Real Email OTP Settings (Optional)
# If provided, OTP codes will be sent directly to user email inboxes via HTML email
# If left blank, OTP codes will print to the server console for local testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chitranshsaxena85@gmail.com
SMTP_PASS=ddza cmpx jmjt sqhg
SMTP_FROM="ExpenseTracker Pro <noreply@expensetracker.app>"
